root = true

[*.cs]
# Style preferences � control when suggestions trigger
dotnet_style_prefer_collection_expression                    = true
csharp_style_prefer_collection_expression                    = when_types_loosely_match
csharp_style_implicit_object_creation_when_type_is_apparent = true
csharp_style_expression_bodied_constructors                  = true
csharp_style_expression_bodied_methods                       = true
csharp_style_expression_bodied_properties                    = true
csharp_style_expression_bodied_accessors                     = true
csharp_style_prefer_switch_expression                        = true

# Escalate all enabled analyzer diagnostics to warnings
dotnet_analyzer_diagnostic.severity = warning
# Enable and escalate all Style-category IDE rules (IDE0001-IDE0xxx) at build time
dotnet_analyzer_diagnostic.category-Style.severity = warning
# Brace-free single-statement bodies (guard clauses, continue/return) are idiomatic
csharp_prefer_braces = false
# KSP API methods like AlarmClockScenario.AddAlarm/DeleteAlarm return bool; we don't use it
dotnet_diagnostic.IDE0058.severity = none
# PollLifeSupport is called via string reflection by Unity InvokeRepeating -- not actually unused
dotnet_diagnostic.IDE0051.severity = none